#!/usr/bin/env python3
"""lavish-sla: every Navid prompt on a watched Lavish page is polled, acked, routed and, if nobody
answers, escalated once. Runs on the host that serves Lavish, systemd user unit lavish-sla.

Every TICK (10 s), against ~/.lavish-axi/state.json and GET /health on the local server:

  1. Watch set. Open sessions (status != ended) whose file exists and which were updated within
     WATCH_DAYS, plus every file named in WATCH_FILE {"files": [...]}. The set is written to
     PROTECTED_FILE ({"files", "updated_at"}), which the lavish-axi fork reads to refuse an agent
     `lavish-axi end` on a watched page.
  2. Exactly one poll. A watched page with no listener for POLL_GRACE gets `lavish-poll-loop <file>`
     started detached (LOOP_NAME is the page stem, or "<dir>-index" for a non-hub index.html, so two
     index.html pages never share a pidfile). A loop or poll still running against an ENDED session
     is killed: an ended session is never re-armed.
  3. Ack (received). A Navid entry (role user, not layout-warnings) newer than the first run, not yet
     answered, gets ONE reply after ACK_AFTER: `📥 received HH:MM · routed to <owner>` (Dhaka time).
     The ack never ticks the note and never counts as an answer: it is posted with
     `reply --done <ACK_NOTICK>`, an id no note has, so no done_at is stamped (a plain reply would tick
     every delivered note). With `reply --ended-ok` a Send & End message on an ended page is acked too,
     without reopening it. Flags are probed once per daemon start (restart after an upgrade).
     An "ANSWER <...> <qid>: <answer>" prompt also sets shared state q:<qid> status=answered in the
     page's directory, so every page binding that question disables it and shows the pick, and the
     ack reads `✅ YOUR PICK <qid>: <answer> · routed to <owner>`.
  4. Route. The owner comes from OWNERS_FILE ({"pages": {basename|session key: worker},
     "qid_prefix": {prefix: worker}}); default "captain". The captain already gets the NAVID row
     from navid-inbox; for any other owner a steer row is appended to the Mac worker queue
     (state/mac-worker-queue.jsonl, run on the Mac by captain-spool-bridge.py as `captain steer`).
     The steer names the prompt id and the exact answer command:
     `lavish-axi reply <page> --done <prompt_id> --agent-reply "<prompt_id>: <one line>"`.
  5. Answered, per prompt id. An entry is answered only by an agent reply that names it: a later
     non-ack agent entry whose text carries the prompt id or whose `done_ids` lists it (lavish-axi lists
     there every note a `reply --done a,b,c` answered, including one a plain reply ticked before), or
     done_at on that note stamped by a non-ack agent entry (done_at equals that reply's `at`) that
     ticked this note alone (`reply --done <id>`). A plain `reply` without --done ticks every delivered
     open note, so a done_at shared by several notes counts only for a note whose id the stamping
     reply's text carries or its `done_ids` lists. A reply to another prompt answers nothing else.
     An answer cached by an older build from such a reply is reopened while the prompt is younger than
     SLA_SEC (an older one stays answered: no alarm burst on deploy). Received (`acked`) and answered
     are separate ids in STATE_FILE.
  6. SLA alarm. An entry still unanswered after SLA_SEC (600) pushes ONE tier-0 line to the captain
     spool: `NAVID UNREPLIED 10m · <page> · <HH:MM Dhaka> · '<text>' · owner <w>`, and if still
     unanswered REMIND_SEC (1800) later, ONE reminder `NAVID STILL UNREPLIED <n>m · ...`. Alarmed and
     reminded ids persist in STATE_FILE, so no repeat across restarts. On a page Navid ended himself
     (status ended, ended_by user) a message sent with the end (same submit, or within SEND_END_SEC
     (60) before it) is a real ask and alarms as usual; only messages sent earlier skip the alarm and
     reminder. lavish-axi stores no end time, so the daemon records it in STATE_FILE["ended"] when it
     first sees the page ended: the session's updated_at, unless that is the `at` of an agent reply
     (then the end time is unknown and every unanswered message alarms).

Ids: "<session key>|<prompt_id or at>". Every decision is persisted in STATE_FILE before the next
step, so a restart neither re-acks, re-routes nor re-alarms. First run baselines existing entries.
Test pages (negctl-*, relaytest-*) are skipped unless ALLOW_TEST_PAGES=1; SLA_PAGE_PREFIX limits
the pages handled (smoke tests). --once runs a single tick.
"""
import datetime as dt, json, os, re, signal, subprocess, sys, time, urllib.request, uuid

HOME = os.path.expanduser("~")
CEO = f"{HOME}/orca/projects/ceo/.tmp"
env = os.environ.get
STATE = env("LAVISH_STATE", f"{HOME}/.lavish-axi/state.json")
URL = env("LAVISH_URL", "http://127.0.0.1:4387")
LAVISH = env("LAVISH_AXI", f"{HOME}/.local/node/bin/lavish-axi")
POLL_LOOP = env("POLL_LOOP", f"{HOME}/.omp/agent/scripts/lavish-poll-loop")
STATE_FILE = env("SLA_STATE", f"{HOME}/.omp/agent/state/lavish-sla.json")
LOG = env("SLA_LOG", f"{HOME}/.omp/agent/state/lavish-sla.log")
WATCH_FILE = env("WATCH_FILE", f"{CEO}/system/lavish-watch.json")
OWNERS_FILE = env("OWNERS_FILE", f"{CEO}/system/lavish-owners.json")
PROTECTED_FILE = env("LAVISH_PROTECTED_FILE", f"{HOME}/.lavish-axi/protected-pages.json")
SPOOL = env("CAPTAIN_PUSH_SPOOL", f"{HOME}/.omp/agent/state/captain-push.jsonl")
MAC_QUEUE = env("MAC_WORKER_QUEUE", f"{HOME}/.omp/agent/state/mac-worker-queue.jsonl")
HUB = env("CAPTAIN_HUB", f"{CEO}/inbox/index.html")
TICK = float(env("TICK_SEC", 10))
ACK_AFTER = float(env("ACK_AFTER_SEC", 60))
SLA = float(env("SLA_SEC", 600))
REMIND = float(env("REMIND_SEC", 1800))
SEND_END = float(env("SEND_END_SEC", 60))
POLL_GRACE = float(env("POLL_GRACE_SEC", 20))
WATCH_DAYS = float(env("WATCH_DAYS", 3))
PREFIX = env("SLA_PAGE_PREFIX", "")
ALLOW_TEST = env("ALLOW_TEST_PAGES") == "1"
TEST_PAGE = re.compile(r"^(negctl|relaytest)-|^test\.html$|^rt\d+\.html$|^cutover-rt\.html$")
ACK_MARK = "📥 received"
PICK_MARK = "✅ YOUR PICK"
ACK_NOTICK = "lavish-sla-ack-notick"  # --done target that matches no note: the ack ticks nothing
DHAKA = dt.timezone(dt.timedelta(hours=6))
ANSWER = re.compile(r"^ANSWER\b(.*?)(?:\n|$)", re.S)


def now():
    return dt.datetime.now(dt.timezone.utc)


def iso(ts):
    return dt.datetime.fromisoformat(str(ts).replace("Z", "+00:00"))


def dhaka(ts):
    return iso(ts).astimezone(DHAKA).strftime("%H:%M")


def log(msg):
    with open(LOG, "a") as f:
        f.write(f"{now().strftime('%Y-%m-%dT%H:%M:%SZ')} {msg}\n")


def load(path, default):
    for _ in range(20):
        try:
            with open(path) as f:
                return json.load(f)
        except FileNotFoundError:
            return default
        except ValueError:
            time.sleep(0.1)  # torn read while the server rewrites the file
    return default


def save(path, data):
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(data, f, ensure_ascii=False)
    os.replace(tmp, path)


def append(path, row):
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        os.write(fd, (json.dumps(row, ensure_ascii=False) + "\n").encode())
    finally:
        os.close(fd)


def push(push_id, text):
    """One tier-0 captain spool row (same shape as captain_push.py)."""
    ts = now().strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"
    append(SPOOL, {"id": push_id, "ts": ts, "worker": "lavish-sla", "tier": 0, "kind": "lavish",
                   "status": "progress", "summary": text[:200], "question": {"id": push_id, "text": text[:200]},
                   "text": text})


def wanted(page):
    return page.startswith(PREFIX) and (ALLOW_TEST or not TEST_PAGE.match(page))


def entry_id(s, c):
    return f"{s['key']}|{c.get('prompt_id') or c['at']}"


def user_entries(s):
    for c in s.get("chat") or []:
        if c.get("role") == "user" and c.get("kind") != "layout-warnings" and c.get("at"):
            yield c


def is_ack(x):
    t = x.get("text", "")
    return t.startswith(ACK_MARK) or t.startswith(PICK_MARK)


def answered_after(s, c):
    """(acked, answered, untrusted) for one Navid entry. acked: a later ack/pick line of this daemon.
    answered: a non-ack agent entry that names this prompt: a later one whose text carries the prompt id
    or whose `done_ids` lists it, or the one whose `at` equals the note's done_at when that stamp was by
    id (`reply --done <id>`). A plain `reply` ticks every delivered open note, so a done_at shared by
    several notes counts only when a reply names this prompt; otherwise untrusted is True and the prompt
    stays open."""
    pid, done = c.get("prompt_id"), c.get("done_at")
    chat = s.get("chat") or []
    acked = answered = stamped_by_ack = untrusted = False
    shared = done is not None and sum(1 for y in chat if y.get("role") == "user" and y.get("done_at") == done) > 1
    for x in chat:
        if x.get("role") != "agent":
            continue
        at = x.get("at", "")
        named = bool(pid) and (pid in x.get("text", "") or pid in (x.get("done_ids") or []))
        if is_ack(x):
            acked = acked or at > c["at"]
            stamped_by_ack = stamped_by_ack or (done is not None and at == done)
        elif named and at > c["at"]:
            answered = True
        elif done and at == done:
            if shared and pid not in (x.get("done_ids") or []):
                untrusted = True
            else:
                answered = True
    if done and not answered and not stamped_by_ack and not any(x.get("at") == done for x in chat):
        answered = True  # the ticking reply was evicted by the transcript bound
    return acked, answered, untrusted and not answered


def loop_name(file):
    stem = os.path.splitext(os.path.basename(file))[0]
    if stem == "index" and os.path.abspath(file) != os.path.abspath(HUB):
        return f"{os.path.basename(os.path.dirname(file))}-index"
    return stem


def procs():
    """(pid, args) of every lavish-poll-loop and lavish-axi poll process."""
    out = subprocess.run(["ps", "-eo", "pid=,args="], capture_output=True, text=True).stdout
    for line in out.splitlines():
        pid, _, args = line.strip().partition(" ")
        if "poll-loop" in args or " poll " in args:
            yield int(pid), args


class Sla:
    def __init__(self):
        self.st = load(STATE_FILE, None)
        self.sessions = []
        self.no_listener = {}  # session key -> monotonic time first seen without a listener

    def baseline(self, sessions):
        ids = sorted(entry_id(s, c) for s in sessions for c in user_entries(s))
        self.st = {"baseline_at": now().isoformat(), "baseline": ids, "acked": {}, "answered": {}, "alarmed": {},
                   "reminded": {}, "routed": {}}
        save(STATE_FILE, self.st)
        log(f"baseline: {len(ids)} existing entries")

    def watch_set(self, sessions):
        extra = set(load(WATCH_FILE, {}).get("files", []))
        horizon = now() - dt.timedelta(days=WATCH_DAYS)
        watched = {}
        for s in sessions:
            f = s.get("file", "")
            if s.get("status") == "ended" or not os.path.exists(f) or not wanted(os.path.basename(f)):
                continue
            if f in extra or (s.get("updated_at") and iso(s["updated_at"]) >= horizon):
                watched[s["key"]] = s
        files = sorted({s["file"] for s in watched.values()} | {f for f in extra if os.path.exists(f)})
        if load(PROTECTED_FILE, {}).get("files") != files:
            save(PROTECTED_FILE, {"files": files, "updated_at": now().strftime("%Y-%m-%dT%H:%M:%SZ")})
        return watched

    def polls(self, sessions, watched, listeners):
        mono = time.monotonic()
        for k, s in watched.items():
            if k in listeners:
                self.no_listener.pop(k, None)
                continue
            first = self.no_listener.setdefault(k, mono)
            if mono - first >= POLL_GRACE:
                e = dict(os.environ, LOOP_NAME=loop_name(s["file"]))
                subprocess.Popen([POLL_LOOP, s["file"]], env=e, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
                log(f"poll started: {s['file']} ({k})")
                self.no_listener[k] = mono  # next attempt waits another grace period
        ended = {s["file"] for s in sessions if s.get("status") == "ended"} - {s["file"] for s in watched.values()}
        for pid, args in procs():
            target = args.split(" --owner")[0].split()[-1] if args.split() else ""
            if target and not target.startswith("/"):
                target = os.path.join(f"{CEO}/inbox", target)  # loops started as `lavish-poll-loop <page.html>`
            if target in ended:
                try:
                    os.kill(pid, signal.SIGTERM)
                    log(f"killed poll on ended session: pid {pid} {args[:160]}")
                except OSError:
                    pass

    def owner(self, s, qid):
        o = load(OWNERS_FILE, {})
        for prefix, w in (o.get("qid_prefix") or {}).items():
            if qid and qid.startswith(prefix):
                return w
        pages = o.get("pages") or {}
        return pages.get(s["key"]) or pages.get(os.path.basename(s["file"])) or "captain"

    def answer_of(self, text):
        """(qid, answer) of an ANSWER prompt: the Context data JSON wins, else '<qid>: <answer>'."""
        m = ANSWER.match(text or "")
        if not m:
            return None, None
        ctx = re.search(r"Context data:\s*(\{.*\})", text, re.S)
        if ctx:
            try:
                d = json.loads(ctx.group(1))
                if d.get("question"):
                    return str(d["question"]), str(d.get("answer", ""))
            except ValueError:
                pass
        head = m.group(1).strip()
        q, _, a = head.partition(":")
        return (q.split()[-1] if q.split() else None), a.strip()

    def flags(self):
        """Which optional `lavish-axi reply` flags this install knows (fork PR: --done, --ended-ok)."""
        if not hasattr(self, "_flags"):
            h = subprocess.run([LAVISH, "reply", "--help"], capture_output=True, text=True, timeout=30)
            self._flags = {f for f in ("--done", "--ended-ok") if f in h.stdout + h.stderr}
        return self._flags

    def reply(self, file, text, prompt_id=None, ended=False):
        """Post a reply. `done` ticks exactly those prompt ids (any round, delivered or not); the ack passes
        ACK_NOTICK so it ticks nothing; with `--ended-ok` it can answer a Send & End message on the ended
        page without reopening it."""
        cmd = [LAVISH, "reply", file, "--agent-reply", text]
        if prompt_id and "--done" in self.flags():
            cmd += ["--done", prompt_id]
        if ended:
            cmd += ["--ended-ok"]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
        return r.returncode, (r.stdout + r.stderr).strip()[-200:]

    def ended_at(self, s, t):
        """When Navid ended this page, or None (not ended by him, or the time is unknown). Recorded once,
        at first sight, and dropped if the page is reopened."""
        st, key = self.st, s["key"]
        if s.get("status") != "ended" or s.get("ended_by") != "user":
            if st["ended"].pop(key, None) is not None:
                save(STATE_FILE, st)
            return None
        if key not in st["ended"]:
            ua = s.get("updated_at")
            by_reply = any(x.get("role") == "agent" and x.get("at") == ua for x in s.get("chat") or [])
            st["ended"][key] = {"at": None if by_reply or not ua else ua, "seen": t.isoformat()}
            save(STATE_FILE, st)
            log(f"ended by user {key} at {st['ended'][key]['at']}")
        at = st["ended"][key]["at"]
        return iso(at) if at else None

    def handle(self, watched):
        st, t = self.st, now()
        for k in ("answered", "reminded", "ended"):
            st.setdefault(k, {})
        base = set(st["baseline"])
        for s in self.sessions:  # ended pages too: a Send & End message is routed, acked and alarmed
            if not wanted(os.path.basename(s.get("file", ""))):
                continue
            ended_at = self.ended_at(s, t)
            live = s["key"] in watched
            for c in user_entries(s):
                eid = entry_id(s, c)
                if eid in base:
                    continue
                age = (t - iso(c["at"])).total_seconds()
                acked, answered, untrusted = answered_after(s, c)
                if eid in st["answered"] and untrusted and age < SLA:
                    # cached by an older build from a plain reply that did not name this prompt; one already past
                    # the SLA at that moment stays answered, so a deploy never fires a burst for history
                    del st["answered"][eid]
                    save(STATE_FILE, st)
                    log(f"reopened {eid}: done_at stamped by a reply that did not name it")
                if eid in st["answered"]:
                    answered = True
                elif answered:
                    st["answered"][eid] = t.isoformat()
                    save(STATE_FILE, st)
                    log(f"answered {eid}")
                qid, ans = self.answer_of(c.get("text", ""))
                owner = self.owner(s, qid)
                if eid not in st["routed"]:
                    if owner != "captain":
                        pid = c.get("prompt_id")
                        how = (f"prompt id {pid}. Handle it, then answer him on the page with exactly this command, which "
                               f"ticks only this prompt (a reply without --done ticks every open prompt on the page): "
                               f"lavish-axi reply {s['file']} --done {pid} --agent-reply \"{pid}: <one line>\"."
                               if pid else
                               f"Handle it, then answer him on the page: lavish-axi reply {s['file']} --agent-reply \"<one line>\".")
                        append(MAC_QUEUE, {"id": uuid.uuid4().hex[:12], "worker": owner, "mode": "steer",
                                           "msg": f"Navid on Lavish page {os.path.basename(s['file'])} at {dhaka(c['at'])} Dhaka: "
                                                  f"{c.get('text', '')[:1500]!r}, {how}",
                                           "at": t.strftime("%Y-%m-%dT%H:%M:%SZ")})
                    st["routed"][eid] = {"owner": owner, "at": t.isoformat()}
                    save(STATE_FILE, st)
                    log(f"routed {eid} -> {owner}")
                can_ack = live or (s.get("status") == "ended" and "--ended-ok" in self.flags())
                if can_ack and eid not in st["acked"] and not acked and not answered and age >= ACK_AFTER:
                    if qid:
                        d = os.path.dirname(s["file"])
                        subprocess.run([LAVISH, "state", "set", f"q:{qid}", "status=answered", f"answer={ans[:400]}",
                                        f"answeredAt={c['at']}", "--source", "navid", "--dir", d],
                                       capture_output=True, timeout=30)
                        text = f"{PICK_MARK} {qid}: {ans[:120]} · routed to {owner}"
                    else:
                        text = f"{ACK_MARK} {dhaka(c['at'])} · routed to {owner}"
                    rc, out = self.reply(s["file"], text, ACK_NOTICK, ended=not live)
                    st["acked"][eid] = {"at": t.isoformat(), "rc": rc}
                    save(STATE_FILE, st)
                    log(f"ack {eid} rc={rc} {text!r} {out if rc else ''}")
                quiet = ended_at is not None and iso(c["at"]) < ended_at - dt.timedelta(seconds=SEND_END)
                if eid not in st["alarmed"] and not answered and not quiet and age >= SLA:
                    push(f"lavish-sla:{eid}", f"NAVID UNREPLIED {int(age // 60)}m · {os.path.basename(s['file'])} · "
                                              f"{dhaka(c['at'])} Dhaka · {c.get('text', '')[:200]!r} · owner {owner}")
                    st["alarmed"][eid] = t.isoformat()
                    save(STATE_FILE, st)
                    log(f"alarm {eid}")
                if eid in st["alarmed"] and eid not in st["reminded"] and not answered and not quiet and age >= SLA + REMIND:
                    push(f"lavish-sla:{eid}:remind", f"NAVID STILL UNREPLIED {int(age // 60)}m · {os.path.basename(s['file'])} · "
                                                     f"{dhaka(c['at'])} Dhaka · {c.get('text', '')[:200]!r} · owner {owner}")
                    st["reminded"][eid] = t.isoformat()
                    save(STATE_FILE, st)
                    log(f"reminder {eid}")

    def tick(self):
        state = load(STATE, None)
        if state is None:
            return
        sessions = list(state.get("sessions", {}).values())
        if self.st is None:
            self.baseline(sessions)
        try:
            with urllib.request.urlopen(f"{URL}/health", timeout=5) as r:
                listeners = {l.get("key") for l in json.load(r).get("listeners", [])}
        except (OSError, ValueError) as e:
            log(f"server unreachable: {e}")
            listeners = None
        watched = self.watch_set(sessions)
        self.sessions = sessions
        if listeners is not None:
            self.polls(sessions, watched, listeners)
        self.handle(watched)


def main():
    sla = Sla()
    log(f"start pid={os.getpid()} prefix={PREFIX!r} ack={ACK_AFTER}s sla={SLA}s")
    while True:
        try:
            sla.tick()
        except Exception as e:  # keep the loop alive; systemd restarts a crash anyway
            log(f"tick error: {e!r}")
        if "--once" in sys.argv:
            return
        time.sleep(TICK)


if __name__ == "__main__":
    main()
